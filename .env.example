# ============================================================
# Mufflux Exhaust System — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Domain ────────────────────────────────────────────────
DOMAIN=mufflux.com

# ── Database ──────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_USER=mufflux_user
MYSQL_PASSWORD=your_strong_db_password_here
MYSQL_DB=mufflux_db

# ── Auth ──────────────────────────────────────────────────
# Must be at least 32 characters, use a random string
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# ── Cloudinary ────────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name

# ── Billplz ───────────────────────────────────────────────
# Get from: https://www.billplz.com → Settings → API
BILLPLZ_API_KEY=your_billplz_api_key
BILLPLZ_COLLECTION_ID=your_collection_id
BILLPLZ_SANDBOX=true   # Change to false for production

# ── Frontend URLs ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.mufflux.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_WHATSAPP_NUMBER=60123456789

# ── Backend URL ───────────────────────────────────────────
BACKEND_URL=https://api.mufflux.com

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=https://mufflux.com,https://www.mufflux.com,http://localhost:3000

# ── Instagram (optional, for homepage feed) ───────────────
INSTAGRAM_ACCESS_TOKEN=your_instagram_basic_display_api_token
